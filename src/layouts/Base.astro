---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '../styles/global.css';
import { sitio } from '../data/sitio.js';

interface Props { titulo?: string; descripcion?: string; indexar?: boolean }
const { titulo = sitio.nombre, descripcion = sitio.descripcion, indexar = true } = Astro.props;
const canonica = new URL(Astro.url.pathname, sitio.url).href;
const imagenSocial = new URL('/og.jpg', sitio.url).href;

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: sitio.nombre,
  url: sitio.url,
  logo: new URL('/apple-touch-icon.png', sitio.url).href,
  email: sitio.correo,
  foundingDate: String(sitio.desde),
  areaServed: 'Chile',
  sameAs: [sitio.instagram.url],
};
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0c0b28" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content={sitio.nombre} />
  <meta property="og:title" content={`${sitio.nombre}: ${sitio.titulo.toLowerCase()}`} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagenSocial} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${sitio.titulo}. ${sitio.nombre}.`} />
  <meta name="twitter:card" content="summary_large_image" />

  {indexar && <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />}
</head>
<body>
  <slot />
</body>
</html>
