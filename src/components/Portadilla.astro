---
// La página de entrada se arma como la portadilla de un libro: el título al centro y,
// al pie, la marca de la casa y cómo encontrarnos.
import { Image } from 'astro:assets';
import logo from '../assets/logo-bl.png';
import { sitio } from '../data/sitio.js';

interface Props { titulo: string; bajada?: string; nivel?: 'h1' | 'p' }
const { titulo, bajada, nivel = 'h1' } = Astro.props;
const Titulo = nivel;
---
<main class="portadilla">
  <div class="portadilla__centro">
    <Titulo class="titulo">{titulo}</Titulo>
    <span class="filete" aria-hidden="true"></span>
    {bajada && <p class="bajada">{bajada}</p>}
    <slot />
  </div>

  <footer class="portadilla__pie">
    <a href="/" class="marca" aria-label={`${sitio.nombre}, inicio`}>
      <Image src={logo} alt="" width={56} height={56} densities={[1, 2, 3]} loading="eager" />
    </a>
    <ul class="contacto">
      <li><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
      <li><a href={sitio.instagram.url} aria-label={`@${sitio.instagram.usuario} en Instagram`}>@{sitio.instagram.usuario}</a></li>
    </ul>
  </footer>
</main>

<style>
  .portadilla {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 2.5rem 1.25rem 2rem;
    text-align: center;
  }
  @media (min-width: 48rem) { .portadilla { padding: 3rem 2rem 2.5rem; } }

  .portadilla__centro {
    align-self: center;
    display: flex; flex-direction: column; align-items: center;
    padding-block: 3rem;
  }

  .titulo {
    margin: 0;
    font-family: 'EB Garamond', 'Garamond', 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 11.6vw, 7.25rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--titulo);
    font-kerning: normal;
    font-feature-settings: 'kern', 'liga';
    text-wrap: balance;
  }

  .filete {
    display: block;
    width: 2.75rem; height: 1px;
    margin: 2.25rem auto 1.5rem;
    background: var(--filete);
  }

  .bajada { font-size: 1rem; letter-spacing: 0.01em; }

  .portadilla__pie {
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
    font-size: 0.95rem;
  }
  .marca { display: block; line-height: 0; background: none; padding: 0; margin-bottom: 0.4rem; }
  .marca img { width: 56px; height: 56px; }
  .contacto {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem 1.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .titulo { animation: aparecer 1.1s cubic-bezier(.2, .7, .2, 1) both; }
    .filete { animation: trazar 0.9s cubic-bezier(.2, .7, .2, 1) 0.45s both; }
    .bajada, .portadilla__pie { animation: aparecer 0.9s ease-out 0.7s both; }
  }
  @keyframes aparecer { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes trazar { from { width: 0; } to { width: 2.75rem; } }
</style>
