---
// Los libros leídos en los clubes de lectura, como lomos en un estante.
// En celular es una sola repisa que se desliza; en pantallas anchas los lomos bajan a una segunda repisa.
import { lecturas } from '../data/lecturas.js';

// Colores de la paleta, cada uno con el color de texto que le da contraste suficiente.
const tapas = [
  { fondo: 'var(--tinta)', texto: '#ffffff' },
  { fondo: 'var(--salmon)', texto: 'var(--noche)' },
  { fondo: 'var(--celeste)', texto: 'var(--noche)' },
  { fondo: 'var(--pistacho)', texto: 'var(--noche)' },
  { fondo: 'var(--rosado)', texto: 'var(--noche)' },
  { fondo: 'var(--durazno)', texto: 'var(--noche)' },
  { fondo: 'var(--azul-medio)', texto: 'var(--noche)' },
];
const altos = [94, 86, 100, 90, 82, 97, 88, 93, 84, 99, 87, 95];
const lomos = lecturas.map((l, i) => ({ ...l, ...tapas[(i * 3) % tapas.length], alto: altos[i % altos.length] }));
---
<div class="estante-marco contenedor">
  <h3 id="estante-titulo">Lo que hemos leído juntos</h3>
  <div class="estante-desliza" tabindex="0" role="region" aria-labelledby="estante-titulo">
    <ul class="estante">
      {lomos.map((l) => (
        <li>
          <span class="lomo" style={`--fondo:${l.fondo};--texto:${l.texto};--alto:${l.alto}%`}>
            <span class="lomo__titulo">{l.titulo}</span>
            <span class="lomo__autor"><span class="sr-only">, de </span>{l.autor}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .estante-marco { margin-top: 2.25rem; }
  .estante-marco h3 { margin-bottom: 0.9rem; }

  .estante-desliza {
    overflow-x: auto; overscroll-behavior-x: contain;
    margin-inline: -16px; padding-inline: 16px;
    scrollbar-width: thin;
  }
  .estante {
    --repisa: 13rem; --tabla: 10px;
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: flex-end; gap: 3px;
    width: max-content;
    background:
      linear-gradient(to bottom, transparent calc(100% - var(--tabla)), var(--madera) calc(100% - var(--tabla)));
  }
  .estante li { height: var(--repisa); display: flex; align-items: flex-end; padding-bottom: var(--tabla); }

  .lomo {
    display: flex; flex-direction: column; justify-content: space-between; gap: 0.6rem;
    writing-mode: vertical-rl; transform: rotate(180deg);
    height: calc((var(--repisa) - var(--tabla) - 0.4rem) * var(--alto) / 100);
    max-inline-size: 100%;
    padding: 0.7rem 0.45rem;
    background:
      linear-gradient(to left, transparent 0.55rem, rgb(255 255 255 / 0.28) 0.55rem, rgb(255 255 255 / 0.28) 0.7rem, transparent 0.7rem),
      linear-gradient(to right, transparent 0.55rem, rgb(255 255 255 / 0.28) 0.55rem, rgb(255 255 255 / 0.28) 0.7rem, transparent 0.7rem),
      var(--fondo);
    color: var(--texto);
    border-radius: 2px 2px 1px 1px;
    line-height: 1.15;
  }
  .lomo__titulo { font-weight: 400; font-size: 0.86rem; }
  .lomo__autor { font-size: 0.72rem; }

  @media (min-width: 60rem) {
    .estante-desliza { overflow: visible; margin-inline: 0; padding-inline: 0; }
    .estante {
      width: auto; flex-wrap: wrap;
      background:
        repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--repisa) - var(--tabla)), var(--madera) calc(var(--repisa) - var(--tabla)), var(--madera) var(--repisa));
    }
  }
</style>
