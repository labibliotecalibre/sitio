---
// Una sección por proyecto: imagen y texto, que en pantallas anchas se alternan a izquierda y derecha.
// «modo» decide cómo entra la imagen en el marco: 'cubrir' (ilustraciones y fotos, se recortan
// según «encuadre») o 'contener' (portadas y figuras recortadas, sobre un fondo de color).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  titulo: string;
  imagen: ImageMetadata;
  alt: string;
  modo?: 'cubrir' | 'contener';
  encuadre?: string;
  fondo?: string;
}
const { id, titulo, imagen, alt, modo = 'cubrir', encuadre = '50% 50%', fondo = 'transparent' } = Astro.props;
---
<section class="proyecto" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="contenedor proyecto__fila">
    <figure class:list={['proyecto__imagen', `proyecto__imagen--${modo}`]} style={`--encuadre:${encuadre};--fondo:${fondo}`}>
      <Image
        src={imagen}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 60rem) 36rem, calc(100vw - 32px)"
        loading="lazy"
      />
    </figure>
    <div class="proyecto__texto pila">
      <h2 id={`${id}-titulo`}>{titulo}</h2>
      <slot />
    </div>
  </div>
  <slot name="abajo" />
</section>

<style>
  .proyecto { padding-block: 2.75rem; }
  .proyecto + :global(.proyecto) { border-top: 1px solid var(--linea); }
  @media (min-width: 60rem) { .proyecto { padding-block: 4.5rem; } }

  .proyecto__fila { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 60rem) {
    .proyecto__fila { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 4rem; }
    :global(.proyecto:nth-of-type(even)) .proyecto__imagen { order: 2; }
  }

  .proyecto__imagen {
    aspect-ratio: 16 / 10; border-radius: var(--radio); overflow: hidden;
    background: var(--fondo);
  }
  .proyecto__imagen img { width: 100%; height: 100%; }
  .proyecto__imagen--cubrir img { object-fit: cover; object-position: var(--encuadre); }
  .proyecto__imagen--contener { padding: 1.25rem; }
  .proyecto__imagen--contener img { object-fit: contain; }

  .proyecto__texto { max-width: var(--medida); }
  .proyecto__texto :global(ul) { padding-left: 1.15rem; }
  .proyecto__texto :global(li + li) { margin-top: 0.35rem; }
  .proyecto__texto :global(li::marker) { color: var(--salmon); }
  .proyecto__texto :global(.nota) { font-size: 0.95rem; }
</style>
