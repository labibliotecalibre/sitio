---
import Base from '../layouts/Base.astro';
import Portadilla from '../components/Portadilla.astro';
import { sitio } from '../data/sitio.js';
---
<Base titulo={`Página no encontrada · ${sitio.nombre}`} indexar={false}>
  <Portadilla titulo="Esta página ya no está" nivel="h1">
    <p class="volver"><a href="/">Volver al inicio</a></p>
  </Portadilla>
</Base>

<script is:inline>
  // Direcciones del sitio anterior que tienen un destino nuevo.
  (function () {
    var ruta = location.pathname.replace(/\/+$/, '');
    if (ruta === '/club-cartas-libros') location.replace('https://cartas.labibliotecalibre.cl/');
  })();
</script>

<style>
  .volver { font-size: 1rem; }
</style>
